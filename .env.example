# Server-side Gemini API key. Never expose this value in frontend code.
GEMINI_API_KEY=""

# Stable Gemini model used by the server.
GEMINI_MODEL="gemini-3.8-flash"

# HTTP port.
PORT="3000"

# Optional persistent state directory. Defaults to ./data.
BOOKFORGE_STATE_DIR="./data"

# Public application URL, if needed by the deployment environment.
APP_URL=""
